# Copia este archivo como backend/.env y llena los valores. El .env no se sube a Git.
# Aquí SÍ van las llaves secretas: este archivo vive solo en el computador que corre el backend.

# Puerto del servidor. La app usa http://<IP de tu computador>:PORT en EXPO_PUBLIC_API_URL
PORT=3000

# Access token de PRUEBA del vendedor (Mercado Pago Developers › Tus integraciones › Credenciales de prueba)
MP_ACCESS_TOKEN=

# Ruta al JSON de la cuenta de servicio de Firebase
# (Consola de Firebase › Configuración del proyecto › Cuentas de servicio › Generar nueva clave privada)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Opcional: URL pública HTTPS del backend (por ejemplo con ngrok). Mercado Pago exige https y no acepta localhost
# en las URL de retorno. Si está vacía, el pago se confirma cuando el conductor cierra el checkout en la app.
PUBLIC_URL=

# Opcional: clave secreta de webhooks (Tus integraciones › Webhooks). Si está, se valida la firma x-signature
MP_WEBHOOK_SECRET=
