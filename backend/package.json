{
  "name": "uberclone-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de pagos de UberClone (Mercado Pago Checkout Pro + Firestore)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/server.js",
