# Copia este archivo como .env y llena los valores. El .env no se sube a Git.
# Las variables EXPO_PUBLIC_ quedan dentro de la app: aquí nunca van llaves secretas.

# Firebase (Firestore)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps Platform: Routes API (reemplazo de Directions y Distance Matrix). Opcional: sin key se usa OSRM.
# Restríngela a la Routes API y activa alertas de presupuesto en Google Cloud.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudinary (fotos de perfil, vehículo y documentos)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# URL del backend de pagos. Vacía = en desarrollo se usa el mismo computador de Expo, puerto 3000.
# El access_token de Mercado Pago va en backend/.env, nunca aquí.
EXPO_PUBLIC_API_URL=
